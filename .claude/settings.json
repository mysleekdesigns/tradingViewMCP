{
  "permissions": {
    "allow": [
      "Bash(npx vitest run*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(bash .claude/scripts/plan-progress.sh*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(/.claude/lab.lock)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh"],
            "timeout": 10,
            "statusMessage": "Loading tradingView phase context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/turn-marker.sh"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.sh"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__.*((place|submit|create|cancel|replace|modify|amend|close)_?(order|position|trade)|withdraw).*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block-order-tools.sh"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__strategy-lab__holdout_check",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/confirm-holdout.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.sh"],
            "timeout": 60,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.sh"],
            "timeout": 300,
            "statusMessage": "Checking areas changed this turn"
          }
        ]
      }
    ]
  }
}
